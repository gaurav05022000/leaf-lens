rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if caller owns the user resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Plants collection owned by the user
      match /plants/{plantId} {
        allow read, write: if isOwner(userId);
      }

      // Scan history logs owned by the user
      match /scan_history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      // Disease logs owned by the user
      match /disease_logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Server-side scan usage enforcement
      match /usage/{dateId} {
        allow read, write: if isOwner(userId);
      }

      // Daily usage synchronization
      match /daily_usage/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Bug / diagnostic reports submitted by users
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false; // Only admin backend can read/update reports
    }
  }
}
